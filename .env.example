# ===== Telegram =====
# Token que te da @BotFather al crear el bot (formato 123456:ABC...)
TELEGRAM_TOKEN=
# Tu user id numérico de Telegram (lo ves con @userinfobot). Solo habilita /estado de admin.
TELEGRAM_ADMIN_ID=

# ===== OpenAI =====
OPENAI_API_KEY=
# Modelos. Poné los que tengas disponibles en tu cuenta (ver DEPLOY.md, paso 3).
#  - NARRADOR: el que narra cada turno (calidad/precio medio)
#  - UTIL: tareas baratas (trasfondos, /radio, resúmenes, modo económico)
#  - GUIONISTA: arma el "guion maestro" al empezar y el epílogo
MODELO_NARRADOR=gpt-5.4-mini
MODELO_UTIL=gpt-5.4-nano
MODELO_GUIONISTA=gpt-5.4-mini
# Precios en USD por millón de tokens (entrada / entrada en caché / salida). Verificalos en https://openai.com/api/pricing
# Solo sirven para calcular el gasto que muestra /costo y para el fusible de presupuesto.
PRECIO_NARRADOR_IN=0.75
PRECIO_NARRADOR_CACHE=0.075
PRECIO_NARRADOR_OUT=4.5
PRECIO_UTIL_IN=0.2
PRECIO_UTIL_CACHE=0.02
PRECIO_UTIL_OUT=1.25
PRECIO_GUIONISTA_IN=0.75
PRECIO_GUIONISTA_CACHE=0.075
PRECIO_GUIONISTA_OUT=4.5
# Esfuerzo de razonamiento para modelos gpt-5/o*: minimal | low | medium | high (vacío = por defecto del modelo)
OPENAI_REASONING_EFFORT=low
# Solo en modo chat: razonamiento de las llamadas con herramientas (gpt-5.4+ exige 'none' en /chat/completions).
OPENAI_REASONING_EFFORT_TOOLS=none
# API de OpenAI: responses (por defecto: el narrador RAZONA aunque use herramientas) o chat (/chat/completions, el modo viejo).
# Si /responses no anda con tu cuenta o modelo, el bot cae solo a chat y lo avisa en el log.
OPENAI_API=responses
# Razonamiento del narrador en los turnos (solo con responses): none | minimal | low | medium | high. Más alto = mejor
# hilo narrativo, pero más lento y más caro (los tokens de razonamiento se cobran como salida).
OPENAI_REASONING_NARRADOR=low
# Auditor de coherencia (narración vs. estado): auto (solo si el texto nombra personajes, daño, muerte u objetos), siempre o nunca.
AUDITOR=auto
MAX_SALIDA_NARRADOR=1500

# ===== Audios (Whisper) =====
# Transcribe las notas de voz que responden a la tarjeta del turno. Usa la misma OPENAI_API_KEY.
MODELO_TRANSCRIPCION=whisper-1
# USD por minuto de audio (referencia para /costo y el fusible: verificá el precio vigente del modelo)
PRECIO_TRANSCRIPCION_MIN=0.006
# Audios más largos que esto se rechazan sin transcribir
MAX_AUDIO_SEG=90

# ===== Fusible de gasto (USD) =====
# 80% avisa, 100% pasa al modelo económico, 200% frena el DJ de esa partida.
PRESUPUESTO_PARTIDA_USD=0.5
# Tope diario global (todas las partidas)
PRESUPUESTO_GLOBAL_USD=2

# ===== Sistema =====
DB_PATH=./data/dj.sqlite
# Argentina = UTC-3 (-180). Se usa para las horas de silencio.
TZ_OFFSET_MIN=-180
PUERTO=3100
